/**
 * Lee los productos y precios de la hoja "Productos" y los devuelve como JSON.
 * El error se corrige asegurando el uso correcto de ContentService.
 */
function doGet(e) {
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const sheetName = "Productos";
    const sheet = spreadsheet.getSheetByName(sheetName);

    if (!sheet) {
        const errorMsg = { error: `Hoja "${sheetName}" no encontrada.` };
        return buildJsonResponse(errorMsg); // Usa la función de apoyo
    }

    const range = sheet.getDataRange();
    const values = range.getValues();

    if (values.length <= 1) {
        const errorMsg = { menu: [], error: 'No se encontraron productos en la hoja.' };
        return buildJsonResponse(errorMsg);
    }

    const headers = values[0].map(h => h.toString().trim());
    const dataRows = values.slice(1);
    
    const requiredHeaders = ["Producto", "Precio", "Categoría"];
    if (!requiredHeaders.every(h => headers.includes(h))) {
        const errorMsg = { error: `Faltan cabeceras requeridas. Asegúrate de tener: ${requiredHeaders.join(', ')}.` };
        return buildJsonResponse(errorMsg);
    }

    const menuData = dataRows.map(row => {
      let item = {};
      headers.forEach((header, index) => {
          if (header.toLowerCase() === 'precio') {
              let priceValue = parseFloat(row[index]);
              item[header] = isNaN(priceValue) ? 0.00 : priceValue;
          } else {
              item[header] = row[index];
          }
      });
      return item;
    }).filter(item => item.Producto && item.Precio > 0);

    const successMsg = { menu: menuData, success: true };
    return buildJsonResponse(successMsg); // Usa la función de apoyo

  } catch (error) {
    const errorMsg = { error: 'Error interno del script: ' + error.toString() };
    return buildJsonResponse(errorMsg);
  }
}

