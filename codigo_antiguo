function doPost(e) {
  try {
    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    var sheetName = "Pedidos";
    var sheet = spreadsheet.getSheetByName(sheetName);
    
    // Si no existe la hoja "Pedidos", crearla
    if (!sheet) {
      sheet = spreadsheet.insertSheet(sheetName);
      sheet.appendRow(["Fecha", "Hora", "Producto", "Cantidad", "Precio Unit.", "Subtotal", "Total Pedido", "Método Pago"]);
    } else {
      // Verificar si existe la columna "Método Pago"
      var lastCol = sheet.getLastColumn();
      if (lastCol < 8) {
        sheet.getRange(1, 8).setValue("Método Pago");
      }
    }
    
    // Obtener los datos
    var dataString = e.parameter.data;
    var data = JSON.parse(dataString);
    
    var fecha = new Date();
    var hora = Utilities.formatDate(fecha, "America/Lima", "HH:mm:ss");
    var fechaStr = Utilities.formatDate(fecha, "America/Lima", "dd/MM/yyyy");
    
    // Determinar método de pago
    var metodoPago = data.yape ? "YAPE" : "";
    
    // Agregar cada producto
    data.items.forEach(function(item) {
      sheet.appendRow([
        fechaStr,
        hora,
        item.producto,
        item.cantidad,
        item.precio,
        item.subtotal,
        data.total,
        metodoPago
      ]);
    });
    
    return ContentService.createTextOutput('success');
    
  } catch(error) {
    return ContentService.createTextOutput('error: ' + error.toString());
  }
}

